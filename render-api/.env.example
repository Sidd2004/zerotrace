# ─── Server ───
PORT=3000
ALLOWED_ORIGINS=https://zerotrace.in,https://www.zerotrace.in

# ─── Supabase (Service Role) ───
SUPABASE_URL=https://hklbzynfekyymrdqlhiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── SMTP (Brevo / Sendinblue) ───
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=xsmtpsib-your-brevo-api-key-here
SMTP_FROM_EMAIL=support@zerotrace.in
SMTP_FROM_NAME=ZeroTrace Security

# ─── Admin ───
ADMIN_EMAIL=zerotrace2004@gmail.com

# ─── Google OAuth (Meeting Scheduler — Calendar only) ───
# Obtain from Google Cloud Console → OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# ─── Resend (Meeting confirmation emails) ───
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=meetings@zerotrace.in
RESEND_FROM_NAME=ZeroTrace
